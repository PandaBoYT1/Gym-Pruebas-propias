// Esquema aprobado - gestion de gimnasio (miembros, personal, inventario, caja)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------

enum Role {
  ADMIN
  MANAGER
  RECEPTIONIST
  TRAINER
  MEMBER
}

enum StaffPosition {
  TRAINER
  RECEPTIONIST
  MANAGER
  NUTRITIONIST
  MAINTENANCE
  OTHER
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipType {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  DAY_PASS
  CLASS_PACK
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  FROZEN
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  INCOME
  EXPENSE
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ---------- AUTH / PERSONAL ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(RECEPTIONIST)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staff          Staff?
  memberProfile  Member?
  cashSessions   CashSession[]   @relation("OpenedBy")
  sales          Sale[]          @relation("ProcessedBy")
  stockMovements StockMovement[] @relation("PerformedBy")
  checkIns       CheckIn[]       @relation("CheckedInBy")
}

model Staff {
  id           String        @id @default(cuid())
  employeeCode String        @unique
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  position     StaffPosition
  hireDate     DateTime
  salary       Decimal?      @db.Decimal(10, 2)
  phone        String?
  status       StaffStatus   @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  shifts             Shift[]
  attendances        StaffAttendance[]
  trainerAssignments TrainerAssignment[] @relation("TrainerOf")

  @@index([status])
}

model Shift {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0 = domingo ... 6 = sabado
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  createdAt DateTime @default(now())

  @@index([staffId, dayOfWeek])
}

model StaffAttendance {
  id         String    @id @default(cuid())
  staffId    String
  staff      Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  checkInAt  DateTime  @default(now())
  checkOutAt DateTime?

  @@index([staffId, checkInAt])
}

model TrainerAssignment {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainerId  String
  trainer    Staff    @relation("TrainerOf", fields: [trainerId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  active     Boolean  @default(true)

  @@index([memberId, active])
  @@index([trainerId, active])
}

// ---------- MIEMBROS ----------

model Member {
  id        String       @id @default(cuid())
  code      String       @unique
  firstName String
  lastName  String
  email     String?      @unique
  phone     String?
  birthDate DateTime?
  address   String?
  photoUrl  String?
  status    MemberStatus @default(ACTIVE)

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        Membership[]
  checkIns           CheckIn[]
  sales              Sale[]
  trainerAssignments TrainerAssignment[]

  @@index([status])
}

model MembershipPlan {
  id           String         @id @default(cuid())
  name         String
  type         MembershipType
  durationDays Int
  price        Decimal        @db.Decimal(10, 2)
  description  String?
  active       Boolean        @default(true)

  memberships Membership[]
}

model Membership {
  id        String           @id @default(cuid())
  memberId  String
  member    Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId    String
  plan      MembershipPlan   @relation(fields: [planId], references: [id])
  startDate DateTime
  endDate   DateTime
  status    MembershipStatus @default(ACTIVE)
  autoRenew Boolean          @default(false)
  createdAt DateTime         @default(now())

  payments Payment[]

  @@index([memberId, status])
}

model CheckIn {
  id             String    @id @default(cuid())
  memberId       String
  member         Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  checkInAt      DateTime  @default(now())
  checkOutAt     DateTime?
  registeredById String?
  registeredBy   User?     @relation("CheckedInBy", fields: [registeredById], references: [id])

  @@index([memberId, checkInAt])
}

// ---------- INVENTARIO ----------

model Category {
  id   String @id @default(cuid())
  name String @unique

  products Product[]
}

model Product {
  id          String    @id @default(cuid())
  sku         String    @unique
  name        String
  description String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  price       Decimal   @db.Decimal(10, 2)
  cost        Decimal?  @db.Decimal(10, 2)
  stock       Int       @default(0)
  minStock    Int       @default(0)
  unit        String    @default("unidad")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stockMovements StockMovement[]
  saleItems      SaleItem[]
}

model StockMovement {
  id            String            @id @default(cuid())
  productId     String
  product       Product           @relation(fields: [productId], references: [id])
  type          StockMovementType
  quantity      Int
  reason        String?
  performedById String
  performedBy   User              @relation("PerformedBy", fields: [performedById], references: [id])
  saleItemId    String?           @unique
  saleItem      SaleItem?         @relation(fields: [saleItemId], references: [id])
  createdAt     DateTime          @default(now())

  @@index([productId, createdAt])
}

// ---------- CAJA ----------

model CashRegister {
  id       String  @id @default(cuid())
  name     String
  location String?
  active   Boolean @default(true)

  sessions CashSession[]
}

model CashSession {
  id             String            @id @default(cuid())
  cashRegisterId String
  cashRegister   CashRegister      @relation(fields: [cashRegisterId], references: [id])
  openedById     String
  openedBy       User              @relation("OpenedBy", fields: [openedById], references: [id])
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  openingAmount  Decimal           @db.Decimal(10, 2)
  closingAmount  Decimal?          @db.Decimal(10, 2)
  expectedAmount Decimal?          @db.Decimal(10, 2)
  difference     Decimal?          @db.Decimal(10, 2)
  status         CashSessionStatus @default(OPEN)

  sales     Sale[]
  movements CashMovement[]

  @@index([status])
}

model CashMovement {
  id            String           @id @default(cuid())
  cashSessionId String
  cashSession   CashSession      @relation(fields: [cashSessionId], references: [id])
  type          CashMovementType
  amount        Decimal          @db.Decimal(10, 2)
  concept       String
  createdAt     DateTime         @default(now())
}

model Sale {
  id            String      @id @default(cuid())
  cashSessionId String
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id])
  memberId      String?
  member        Member?     @relation(fields: [memberId], references: [id])
  processedById String
  processedBy   User        @relation("ProcessedBy", fields: [processedById], references: [id])
  total         Decimal     @db.Decimal(10, 2)
  status        SaleStatus  @default(COMPLETED)
  createdAt     DateTime    @default(now())

  items    SaleItem[]
  payments Payment[]

  @@index([cashSessionId])
  @@index([createdAt])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)

  stockMovement StockMovement?
}

model Payment {
  id           String        @id @default(cuid())
  saleId       String?
  sale         Sale?         @relation(fields: [saleId], references: [id])
  membershipId String?
  membership   Membership?   @relation(fields: [membershipId], references: [id])
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod
  status       PaymentStatus @default(COMPLETED)
  reference    String?
  paidAt       DateTime      @default(now())

  @@index([saleId])
  @@index([membershipId])
}
